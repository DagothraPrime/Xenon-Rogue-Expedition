<?xml version="1.0" encoding="utf-8"?>
<!-- dockarea_dag_invisible_ms_macro.xml
     Custom dual-purpose invisible dockarea wrapper for zzz_dag mods.
     Use this instead of Re-emergence's dockarea_invisible_m_macro or dockarea_invisible_s_macro
     anywhere you need a single clamp type that accepts both S and M ships.
     Reference connection name: ConnectionFor_dockingbay_dag_invisible_ms_macro -->
<macros>
  <macro name="dockarea_dag_invisible_ms_macro" class="dockarea">
    <component ref="dockarea_invisible_m" />
    <properties>
      <identification name="{20104, 70001}" description="{20104, 70002}" />
      <hull integrated="1" />
      <sound_occlusion inside="0.2" outside="0.5" />
    </properties>
    <connections>
      <connection ref="ConnectionFor_dockingbay_dag_invisible_ms_macro">
        <macro ref="dockingbay_dag_invisible_ms_macro" connection="position" />
      </connection>
    </connections>
  </macro>
</macros>
