<?xml version="1.0" encoding="utf-8"?>
<!-- ship_xen_xl_builder_heb_01_macro.xml
     H-EB (Expeditionary Builder) - Xenon H drone boat converted to builder role.
     Fixes vs previous version:
     - Dockarea connection name corrected to ConnectionFor_dockingbay_arg_s_01_macro
       (vanilla H macro had this wrong too - inherited bug)
     - Launch tubes swapped from launchtube_arg_s_01_macro to launchtube_xen_s_01_macro
     - Cockpit swapped from bridge_tfm_l_01_macro to cockpit_gen_invisible_01_macro
       (TFM bridge is an Argon/Timelines asset, invisible is cleaner for Xenon drone hull)
     Note: class="ship_xl" on macro is intentional - required for builder type recognition.
           Component remains class="ship_l" (geometry/space tag unchanged). -->
<macros>
  <macro name="ship_xen_xl_builder_heb_01_macro" class="ship_xl">
    <component ref="ship_xen_xl_builder_heb_01" />
    <properties>
      <identification name="{9905001,400}" basename="{9905001,400}" makerrace="xenon" description="{9905001,401}" icon="ship_xl_builder_01" />
      <software>
        <software ware="software_dockmk2" compatible="1" />
        <software ware="software_flightassistmk1" default="1" />
        <software ware="software_scannerlongrangemk1" default="1" />
        <software ware="software_scannerlongrangemk2" compatible="1" />
        <software ware="software_scannerobjectmk1" default="1" />
        <software ware="software_scannerobjectmk2" compatible="1" />
        <software ware="software_targetmk1" compatible="1" />
        <software ware="software_trademk1" default="1" />
      </software>
      <jerk>
        <forward accel="0.32" decel="0.72" ratio="3" />
        <forward_boost accel="0.32" ratio="3" />
        <forward_travel accel="0.32" decel="0.82" ratio="3" />
        <strafe value="0.45" />
        <angular value="0.42" />
      </jerk>
      <explosiondamage value="1000" shield="5000" />
      <storage missile="24" unit="96" />
      <hull max="124000" />
      <secrecy level="2" />
      <steeringcurve>
        <point position="1.01" value="1" />
        <point position="1.2" value="0.9" />
        <point position="1.6" value="0.8" />
        <point position="2.1" value="0.45" />
        <point position="2.4" value="0.3" />
        <point position="2.7" value="0.24" />
      </steeringcurve>
      <purpose primary="build" />
      <people capacity="32" />
      <sounds>
        <shipdetail ref="shipdetail_xenon_l_01" />
      </sounds>
      <physics mass="255.0">
        <inertia pitch="175" yaw="175" roll="110" />
        <drag forward="185" reverse="735" horizontal="60" vertical="60" pitch="120" yaw="120" roll="120" />
      </physics>
      <thruster tags="large" />
      <ship type="builder" prestige="28" />
      <boarding resistance="1750" />
    </properties>
    <connections>
      <!-- Cockpit - invisible, appropriate for Xenon drone hull -->
      <connection ref="con_cockpit_01">
        <macro ref="cockpit_gen_invisible_01_macro" connection="con_cockpit_01" />
      </connection>
      <!-- S dockarea - physical Argon dock on vanilla H hull geometry -->
      <connection ref="con_dockarea_arg_s_ship_01">
        <macro ref="dockarea_arg_s_ship_01_macro" connection="ConnectionFor_dockingbay_arg_s_01_macro" />
      </connection>
      <!-- XS drone dock -->
      <connection ref="con_dock_xs_01">
        <macro ref="dock_gen_xs_ship_01_macro" connection="Connection_component" />
      </connection>
      <!-- Launch tubes - Xenon S tubes replacing vanilla Argon ones -->
      <connection ref="con_launchtube_arg_s_01">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_02">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_03">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_04">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_05">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_06">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_07">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_08">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_09">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_10">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_11">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_12">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_13">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <connection ref="con_launchtube_arg_s_14">
        <macro ref="launchtube_xen_s_01_macro" connection="Connection02" />
      </connection>
      <!-- Ship storage bays -->
      <connection ref="con_shipstorage_s_01">
        <macro ref="shipstorage_gen_s_sixteen_macro" connection="object" />
      </connection>
      <connection ref="con_shipstorage_xs_01">
        <macro ref="shipstorage_gen_xs_01_macro" connection="object" />
      </connection>
      <!-- Cargo storage - reuses vanilla H terraformer storage macro -->
      <connection ref="con_storage_01">
        <macro ref="storage_xen_l_terraformer_01_a_macro" connection="ShipConnection" />
      </connection>
    </connections>
  </macro>
</macros>
