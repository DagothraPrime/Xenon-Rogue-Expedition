<?xml version="1.0" encoding="utf-8"?>
<!-- ship_xen_m_tm_pe_01_macro.xml
     PE-TM Expeditionary Escort - Xenon PE corvette converted to M carrier/TM role.
     Fixes vs previous version:
     - All three invisible dockarea clamps swapped from dockarea_invisible_s_macro to
       dockarea_dag_invisible_ms_macro (accepts S and M ships, correct connection name)
     - Added software_trademk2 as compatible for consistency with fleet
     - Added boarding resistance (was missing, vanilla PE corvette has one)
     Component is unchanged. -->
<macros>
  <macro name="ship_xen_m_tm_pe_01_macro" class="ship_m">
    <component ref="ship_xen_m_tm_pe_01" />
    <properties>
      <identification name="{9905001,300}" basename="{9905001,300}" description="{9905001,301}" makerrace="xenon" icon="ship_m_corvette_01" />
      <software>
        <software ware="software_dockmk2" compatible="1" />
        <software ware="software_flightassistmk1" default="1" />
        <software ware="software_scannerlongrangemk1" default="1" />
        <software ware="software_scannerlongrangemk2" compatible="1" />
        <software ware="software_scannerobjectmk1" default="1" />
        <software ware="software_scannerobjectmk2" compatible="1" />
        <software ware="software_targetmk1" default="1" />
        <software ware="software_trademk1" compatible="1" />
        <software ware="software_trademk2" compatible="1" />
      </software>
      <jerk>
        <forward accel="0.4" decel="0.8" ratio="3" />
        <forward_boost accel="0.6" ratio="3" />
        <forward_travel accel="0.4" decel="0.9" ratio="3" />
        <strafe value="0.6" />
        <angular value="0.5" />
      </jerk>
      <explosiondamage value="500" shield="2500" />
      <storage missile="36" />
      <hull max="13500" />
      <glow engine="1" />
      <secrecy level="2" />
      <steeringcurve>
        <point position="1.01" value="1" />
        <point position="1.3" value="0.65" />
        <point position="1.6" value="0.45" />
        <point position="2" value="0.32" />
        <point position="2.3" value="0.2" />
        <point position="3" value="0.15" />
      </steeringcurve>
      <purpose primary="fight" />
      <people capacity="6" />
      <sounds>
        <shipdetail ref="shipdetail_xenon_m_01" />
      </sounds>
      <physics mass="24.634">
        <inertia pitch="7.1" yaw="7.1" roll="6.3" />
        <drag forward="11.906" reverse="47.622" horizontal="14.756" vertical="14.756" pitch="8.659" yaw="8.659" roll="8.659" />
      </physics>
      <thruster tags="medium" />
      <loadouts>
        <loadout id="default">
          <macros>
            <engine macro="engine_xen_m_virtual_01_mk1_macro" path="../con_engine_01" />
            <engine macro="engine_xen_m_virtual_01_mk1_macro" path="../con_engine_02" />
            <engine macro="engine_xen_m_virtual_01_mk1_macro" path="../con_engine_03" />
            <engine macro="engine_xen_m_virtual_01_mk1_macro" path="../con_engine_04" />
            <shield macro="shield_xen_m_virtual_01_mk1_macro" path="../con_shield_01" />
            <shield macro="shield_xen_m_virtual_01_mk1_macro" path="../con_shield_02" />
            <turret macro="turret_xen_m_gatling_01_mk1_macro" path="../con_turret_m_01" optional="1" />
            <turret macro="turret_xen_m_gatling_01_mk1_macro" path="../con_turret_m_02" optional="1" />
            <weapon macro="weapon_xen_m_laser_02_mk1_macro" path="../con_weapon_01" optional="1" />
            <weapon macro="weapon_xen_m_laser_02_mk1_macro" path="../con_weapon_02" optional="1" />
          </macros>
          <ammunition>
            <ammunition macro="countermeasure_flares_01_macro" min="0" max="8" optional="1" />
          </ammunition>
          <virtualmacros>
            <thruster macro="thruster_gen_m_combat_01_mk3_macro" />
          </virtualmacros>
        </loadout>
      </loadouts>
      <ship type="carrier" prestige="32" />
      <boarding resistance="800" />
    </properties>
    <connections>
      <!-- Virtual cockpit -->
      <connection ref="con_cockpit_01">
        <macro ref="cockpit_gen_virtual_01_macro" connection="ship" />
      </connection>
      <!-- XS drone dock -->
      <connection ref="con_dock_xs">
        <macro ref="dock_gen_xs_ship_01_macro" connection="Connection_component" />
      </connection>
      <!-- XS ship storage bay -->
      <connection ref="con_shipstorage_xs_01">
        <macro ref="shipstorage_gen_xs_01_macro" connection="object" />
      </connection>
      <!-- Cargo storage -->
      <connection ref="con_storage_01">
        <macro ref="storage_xen_m_corvette_02_a_macro" connection="ShipConnection" />
      </connection>
      <!-- dag dual-purpose S+M invisible docking clamps (left, right, tail)
           Accepts both S and M ships. M docking on an M hull is tight spatially
           but the game won't prevent it - just don't expect it to look pretty. -->
      <connection ref="con_dockingarea_invisible_left_01">
        <macro ref="dockarea_dag_invisible_ms_macro" connection="ConnectionFor_dockingbay_dag_invisible_ms_macro" />
      </connection>
      <connection ref="con_dockingarea_invisible_right_01">
        <macro ref="dockarea_dag_invisible_ms_macro" connection="ConnectionFor_dockingbay_dag_invisible_ms_macro" />
      </connection>
      <connection ref="con_dockingarea_invisible_tail_01">
        <macro ref="dockarea_dag_invisible_ms_macro" connection="ConnectionFor_dockingbay_dag_invisible_ms_macro" />
      </connection>
      <!-- Carrier build module -->
      <connection ref="con_buildmodule">
        <macro ref="buildmodule_gen_carrier_s_macro" connection="object" />
      </connection>
    </connections>
  </macro>
</macros>
