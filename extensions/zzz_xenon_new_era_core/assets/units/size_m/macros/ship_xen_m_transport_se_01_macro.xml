<?xml version="1.0" encoding="utf-8"?>
<!-- ship_xen_m_transport_se_01_macro.xml
     SE-T (Expeditionary Trader) - Xenon SE converted to L-class freighter.
     class="ship_l" on both macro and component - correct.
     Fixes vs previous version:
     - Removed con_dock_xs (connection doesn't exist on SE hull component)
     - Removed con_unit_launcher_01 / dockingbay_invisible_m_macro (wrong approach).
       Cargo drone function handled by con_cargotube_01 in component + dockingbay allowunits="1".
     - thruster tags corrected from "medium" to "large" to match class="ship_l"
     - Removed invalid software_computer_trading_v1 ware
     - Added software_trademk2 as compatible upgrade (Advanced Trade Computer)
     - storage unit bumped from 12 to 36 (drone carry capacity) -->
<macros>
  <macro name="ship_xen_m_transport_se_01_macro" class="ship_l">
    <component ref="ship_xen_m_transport_se_01" />
    <properties>
      <identification name="{9905001,200}" basename="{9905001,200}" description="{9905001,201}" makerrace="xenon" icon="ship_m_miner_01" />
      <software>
        <software ware="software_dockmk2" compatible="1" />
        <software ware="software_flightassistmk1" default="1" />
        <software ware="software_scannerlongrangemk1" default="1" />
        <software ware="software_scannerlongrangemk2" compatible="1" />
        <software ware="software_scannerobjectmk1" default="1" />
        <software ware="software_scannerobjectmk2" compatible="1" />
        <software ware="software_targetmk1" compatible="1" />
        <software ware="software_trademk1" default="1" />
        <software ware="software_trademk2" compatible="1" />
      </software>
      <jerk>
        <forward accel="0.38" decel="0.76" ratio="3" />
        <forward_boost accel="0.58" ratio="3" />
        <forward_travel accel="0.4" decel="0.88" ratio="3" />
        <strafe value="0.56" />
        <angular value="0.47" />
      </jerk>
      <explosiondamage value="500" shield="2500" />
      <hull max="6800" />
      <glow engine="1" />
      <secrecy level="2" />
      <steeringcurve>
        <point position="1.01" value="1" />
        <point position="1.3" value="0.65" />
        <point position="1.6" value="0.45" />
        <point position="2" value="0.32" />
        <point position="2.3" value="0.2" />
        <point position="3" value="0.15" />
      </steeringcurve>
      <purpose primary="trade" />
      <!-- unit = cargo drone carry capacity. 36 is appropriate for a small L freighter. -->
      <storage unit="36" />
      <!-- allowunits="1" enables cargo drone use via con_cargotube_01 in component. -->
      <dockingbay allowunits="1" />
      <people capacity="4" />
      <physics mass="48.750">
        <inertia pitch="7.35" yaw="7.35" roll="5.90" />
        <drag forward="8.0" reverse="31.8" horizontal="26.9" vertical="26.9" pitch="14.55" yaw="14.55" roll="14.55" />
      </physics>
      <thruster tags="large" />
      <ship type="freighter" prestige="18" />
    </properties>
    <connections>
      <!-- Virtual cockpit - appropriate for player-controlled Xenon freighter -->
      <connection ref="con_cockpit_01">
        <macro ref="cockpit_gen_virtual_01_macro" connection="ship" />
      </connection>
      <!-- XS drone storage bay -->
      <connection ref="con_shipstorage_xs_01">
        <macro ref="shipstorage_gen_xs_01_macro" connection="object" />
      </connection>
      <!-- Cargo storage -->
      <connection ref="con_storage_01">
        <macro ref="storage_xen_m_transport_01_macro" connection="ShipConnection" />
      </connection>
    </connections>
  </macro>
</macros>
