<?xml version="1.0" encoding="utf-8"?>
<mdscript name="nez_start_init" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>

    <!-- Boot message sequence - sequential cue pattern is valid X4 MD, no changes needed here -->
    <cue name="NEZ_Start_Init" module="nez_rogue_xenon_expedition">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart"/>
      </conditions>
      <actions>
        <set_faction_identity faction="faction.player" prefixname="'{20203,1101}'" name="'Rogue Xenon'"/>
      </actions>
      <delay exact="90s"/>
      <actions>
        <show_help duration="18s" force="true" custom="'[NEZ] Expedition boot complete. Board the PE-TM and bring the swarm online.'"/>
      </actions>
      <delay exact="210s"/>
      <actions>
        <show_help duration="18s" force="true" custom="'[NEZ] Expedition ping repeat. TM, escorts, and builder should now be live in Xaar''s Belt I.'"/>
      </actions>
    </cue>

    <!-- Subordinate fixup and CPU pilot assignment -->
    <cue name="NEZ_Start_Subordinate_Fixup" module="nez_rogue_xenon_expedition">
      <conditions>
        <event_cue_signalled cue="md.Setup.GameStart"/>
      </conditions>
      <delay exact="30s"/>
      <actions>
        <find_ship name="$cpuship" faction="faction.player" space="player.galaxy" macro="macro.nez_xen_cpu_factory_01_macro"/>
        <find_ship groupname="$cpudefenders" faction="faction.player" space="player.galaxy" multiple="true" macro="macro.ship_xen_m_fighter_d_macro"/>

        <!-- FIX: Was passing $cpudefenders group directly to create_order object param.
             Groups need explicit iteration. Loop over each defender and assign individually. -->
        <do_if value="$cpuship.exists and $cpudefenders.count gt 0">
          <do_all exact="$cpudefenders.count" counter="$i">
            <create_order id="'AssignCommander'" object="$cpudefenders.{$i}" immediate="true">
              <param name="commander" value="$cpuship"/>
              <param name="assignment" value="assignment.defence"/>
              <param name="cancelorders" value="true"/>
            </create_order>
          </do_all>
        </do_if>

        <!-- GLADOS-core pilot assignment for CPU Factory ship.
             REMOVED: ReplaceTraderWithXenonCore cue - it used invalid MD action syntax.
               <macro ref="..."/> and <owner exact="..."/> are not valid MD actions.
             REPLACEMENT: create_pilot with character macro, done here where $cpuship is already found.

             VERIFY BEFORE ENABLING: character_xenon_core_01_macro must be a valid Re-emergence
             macro. Check Re-emergence's character/npc asset files to confirm the exact macro name.
             If the macro doesn't exist, comment out the create_pilot block below - the CPU ship
             will simply retain whatever default pilot the game assigns from its pilot skills block. -->
        <do_if value="$cpuship.exists">
          <create_pilot name="$corePilot" macro="macro.character_xenon_core_01_macro" object="$cpuship"/>
        </do_if>
      </actions>
    </cue>

  </cues>
</mdscript>
